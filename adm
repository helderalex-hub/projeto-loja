<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <title>Painel Administrativo | Beleza & Companhia</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        :root { --dark: #0f172a; --card: #1e293b; --rosa: #d63384; --rosa-claro: #ffb6c1; --texto: #f8fafc; --verde: #22c55e; --azul: #3b82f6; --laranja: #f59e0b; }
        body { font-family: 'Inter', system-ui, sans-serif; background: var(--dark); color: var(--texto); margin: 0; padding: 20px; line-height: 1.5; }
        .container { max-width: 1100px; margin: 0 auto; }
        
        h1 { color: var(--rosa); text-align: center; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 30px; font-weight: 800; }
        
        /* 1. Área de Dashboards */
        .dashboard { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 30px; }
        .card-dash { background: var(--card); padding: 20px; border-radius: 12px; text-align: center; border: 1px solid rgba(255,255,255,0.05); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
        .card-dash h3 { font-size: 11px; color: #94a3b8; text-transform: uppercase; margin: 0; letter-spacing: 1px; }
        .card-dash p { font-size: 26px; font-weight: bold; margin: 10px 0 0; }

        /* Layout de 2 Colunas (Área 2 e 3) */
        .grid-meio { display: grid; grid-template-columns: 1fr 1.5fr; gap: 20px; margin-bottom: 40px; }

        /* 2. Área de Relatórios/Alertas */
        .card-alertas { background: var(--card); padding: 20px; border-radius: 15px; border: 1px solid #334155; }
        .alerta-item { background: #0f172a; padding: 12px; border-radius: 8px; margin-bottom: 10px; display: flex; justify-content: space-between; border-left: 4px solid var(--azul); }

        /* 3. Área de Cadastro Unificado */
        .card-form { background: var(--card); padding: 25px; border-radius: 15px; border: 1px solid #334155; display: flex; gap: 20px; align-items: flex-start; }
        
        .foto-click-area { 
            width: 100px; height: 100px; border-radius: 12px; border: 2px dashed #475569; 
            background: #0f172a; display: flex; align-items: center; justify-content: center; 
            cursor: pointer; overflow: hidden; transition: 0.3s; flex-shrink: 0;
        }
        .foto-click-area:hover { border-color: var(--rosa); background: #1e293b; }
        .foto-click-area img { width: 100%; height: 100%; object-fit: cover; }
        .foto-click-area span { font-size: 10px; color: #64748b; text-align: center; font-weight: bold; }

        .form-content { flex: 1; }
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        label { font-size: 11px; color: #94a3b8; text-transform: uppercase; font-weight: bold; margin-bottom: 4px; display: block; }
        input { width: 100%; padding: 10px; background: #0f172a; border: 1px solid #334155; color: white; border-radius: 8px; box-sizing: border-box; margin-bottom: 10px; }
        input:focus { border-color: var(--rosa); outline: none; }
        
        button#btnSalvar { background: var(--rosa); color: white; border: none; padding: 15px; width: 100%; border-radius: 10px; font-weight: bold; cursor: pointer; text-transform: uppercase; margin-top: 10px; transition: 0.3s; }
        button#btnSalvar:hover { filter: brightness(1.2); }

        /* 4. Área de Lista de Produtos */
        .header-lista { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #334155; padding-bottom: 10px; margin-bottom: 20px; }
        .btn-export { background: var(--verde); color: #0f172a; border: none; padding: 10px 15px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 11px; }

        .produto-card { background: var(--card); padding: 15px; margin-bottom: 12px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center; gap: 20px; transition: 0.2s; }
        .produto-card:hover { border-color: var(--rosa); }
        .img-wrapper { position: relative; width: 65px; height: 65px; flex-shrink: 0; }
        .img-produto-lista { width: 100%; height: 100%; border-radius: 10px; object-fit: cover; border: 2px solid #334155; cursor: pointer; }
        
        .img-loading { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); border-radius: 10px; display: none; align-items: center; justify-content: center; }

        .prod-info { flex: 1; }
        .prod-info strong { color: var(--rosa-claro); font-size: 17px; display: block; margin-bottom: 3px; }
        .prod-stats { font-size: 12px; color: #94a3b8; }
        .prod-stats b { color: var(--texto); }

        .acoes { display: flex; gap: 8px; }
        .btn-edit { background: rgba(59, 130, 246, 0.2); color: var(--azul); border: none; padding: 10px; border-radius: 8px; cursor: pointer; }
        .btn-del { background: rgba(239, 68, 68, 0.2); color: #ef4444; border: none; padding: 10px; border-radius: 8px; cursor: pointer; }

        .spinner { animation: rotate 1s linear infinite; display: inline-block; font-size: 14px; }
        @keyframes rotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

        @media (max-width: 850px) { .grid-meio { grid-template-columns: 1fr; } .card-form { flex-direction: column; align-items: center; } }
    </style>
</head>
<body>

    <div class="container">
        <h1>💎 Painel Administrativo</h1>
        
        <div class="dashboard">
            <div class="card-dash"><h3>Total Venda (PVP)</h3><p id="dash-fatura" style="color:var(--azul)">€ 0.00</p></div>
            <div class="card-dash"><h3>Total Custo</h3><p id="dash-custo" style="color:var(--laranja)">€ 0.00</p></div>
            <div class="card-dash"><h3>Margem Bruta</h3><p id="dash-margem" style="color:var(--verde)">€ 0.00</p></div>
        </div>

        <div class="grid-meio">
            <div class="card-alertas">
                <h2 style="font-size: 16px; margin-bottom: 15px;">📊 Relatórios Rápidos</h2>
                <div class="alerta-item"><span>Itens Críticos (≤5)</span><b id="rep-critico" style="color:var(--rosa)">0</b></div>
                <div class="alerta-item"><span>Variedade de Mix</span><b id="rep-mix">0</b></div>
                <div class="alerta-item"><span>Valor Médio Item</span><b id="rep-media">€ 0.00</b></div>
            </div>

            <div class="card-form">
                <div class="foto-click-area" onclick="document.getElementById('foto-input').click()">
                    <img id="preview-foto-form" src="" style="display:none">
                    <span id="label-foto">📷 + FOTO</span>
                </div>
                <input type="file" id="foto-input" accept="image/*" style="display:none">

                <div class="form-content">
                    <input type="hidden" id="edit-id">
                    <label>Nome do Produto</label>
                    <input type="text" id="nome" placeholder="Ex: Sérum Revitalizante">
                    
                    <div class="form-grid">
                        <div><label>Custo (€)</label><input type="number" id="preco_entrada" step="0.01" value="0"></div>
                        <div><label>Venda (€)</label><input type="number" id="preco" step="0.01" value="0"></div>
                        <div><label>Stock</label><input type="number" id="estoque" value="0"></div>
                        <div><label>Validade</label><input type="date" id="validade"></div>
                    </div>
                    <button id="btnSalvar">ADICIONAR PRODUTO</button>
                    <button onclick="limparForm()" style="background:none; border:none; color:#64748b; font-size:11px; width:100%; margin-top:5px; cursor:pointer">LIMPAR / NOVO</button>
                </div>
            </div>
        </div>

        <div class="header-lista">
            <h2>Inventário Ativo</h2>
            <button class="btn-export" onclick="exportarCSV()">📥 EXPORTAR CSV</button>
        </div>
        <div id="lista">A carregar dados...</div>
    </div>

    <input type="file" id="edit-foto-input" style="display:none" accept="image/*">

    <script>
        // Configuração
        const API = 'https://projeto-loja-beleza-cia.onrender.com/produtos';
        const S_URL = 'https://sgamfzcgiexoevnyiehn.supabase.co';
        const S_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNnYW1memNnaWV4b2V2bnlpZWhuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njg5MzIwMDYsImV4cCI6MjA4NDUwODAwNn0.BLdnOWXEpW6w_Ic_0stcOexXXQBWl7Rc5ll0ATjvZVs';
        const sbClient = window.supabase.createClient(S_URL, S_KEY);
        
        let produtosGlobais = [];
        let idProdutoEditandoFoto = null;

        // Preview da foto no formulário
        document.getElementById('foto-input').onchange = (e) => {
            const file = e.target.files[0];
            if (file) {
                const img = document.getElementById('preview-foto-form');
                img.src = URL.createObjectURL(file);
                img.style.display = 'block';
                document.getElementById('label-foto').style.display = 'none';
            }
        };

        // Carregar dados e preencher áreas
        async function carregarDados() {
            const div = document.getElementById('lista');
            try {
                const res = await fetch(API);
                produtosGlobais = await res.json();
                div.innerHTML = '';
                
                let fT = 0, cT = 0, crit = 0;

                produtosGlobais.forEach(p => {
                    const v = parseFloat(p.preco || 0), c = parseFloat(p.preco_entrada || 0), s = parseInt(p.estoque || 0);
                    fT += (v * s); cT += (c * s);
                    if(s <= 5) crit++;

                    div.innerHTML += `
                        <div class="produto-card">
                            <div class="img-wrapper">
                                <img src="${p.imagem || ''}" class="img-produto-lista" onclick="triggerTrocarFoto('${p.id}')" onerror="this.src='https://via.placeholder.com/70?text=S/F'">
                                <div class="img-loading" id="load-${p.id}"><span class="spinner">⏳</span></div>
                            </div>
                            <div class="prod-info">
                                <strong>${p.nome}</strong>
                                <div class="prod-stats">
                                    <span>Venda: <b>€${v.toFixed(2)}</b> | Custo: <b>€${c.toFixed(2)}</b> | Stock: <b style="color: ${s <= 5 ? 'var(--rosa)' : 'white'}">${s}</b></span>
                                </div>
                            </div>
                            <div class="acoes">
                                <button class="btn-edit" onclick="prepararEdicao(${JSON.stringify(p).replace(/"/g, '&quot;')})">✏️</button>
                                <button class="btn-del" onclick="deletar('${p.id}')">🗑️</button>
                            </div>
                        </div>`;
                });

                // Atualizar Dashboards
                document.getElementById('dash-fatura').innerText = '€ ' + fT.toFixed(2);
                document.getElementById('dash-custo').innerText = '€ ' + cT.toFixed(2);
                document.getElementById('dash-margem').innerText = '€ ' + (fT - cT).toFixed(2);
                
                // Atualizar Relatórios
                document.getElementById('rep-critico').innerText = crit;
                document.getElementById('rep-mix').innerText = produtosGlobais.length;
                document.getElementById('rep-media').innerText = '€ ' + (fT / (produtosGlobais.length || 1)).toFixed(2);

            } catch (e) { div.innerHTML = "Erro ao ligar ao servidor."; }
        }

        // Trocar foto ao clicar na imagem da lista
        function triggerTrocarFoto(id) { 
            idProdutoEditandoFoto = id; 
            document.getElementById('edit-foto-input').click(); 
        }

        document.getElementById('edit-foto-input').onchange = async (e) => {
            const file = e.target.files[0];
            if (!file) return;
            const loader = document.getElementById(`load-${idProdutoEditandoFoto}`);
            loader.style.display = 'flex';
            
            const nArq = `img-${Date.now()}.jpg`;
            const { error } = await sbClient.storage.from('fotos-produtos').upload(nArq, file);
            
            if (!error) {
                const { data } = sbClient.storage.from('fotos-produtos').getPublicUrl(nArq);
                const pOriginal = produtosGlobais.find(i => i.id == idProdutoEditandoFoto);
                
                await fetch(API + '/' + idProdutoEditandoFoto, { 
                    method: 'PUT', 
                    headers: {'Content-Type': 'application/json'}, 
                    body: JSON.stringify({ ...pOriginal, imagem: data.publicUrl }) 
                });
                carregarDados();
            } else { loader.style.display = 'none'; alert("Erro no upload."); }
        };

        // Salvar (POST ou PUT)
        document.getElementById('btnSalvar').onclick = async () => {
            const btn = document.getElementById('btnSalvar');
            const id = document.getElementById('edit-id').value;
            const nome = document.getElementById('nome').value;
            if(!nome) return alert("Insira o nome!");

            btn.disabled = true; btn.innerText = "A PROCESSAR...";
            
            let urlFinal = document.getElementById('preview-foto-form').src;
            if (urlFinal.startsWith('blob:')) {
                const arquivo = document.getElementById('foto-input').files[0];
                const path = `new-${Date.now()}.jpg`;
                const { error } = await sbClient.storage.from('fotos-produtos').upload(path, arquivo);
                if(!error) urlFinal = sbClient.storage.from('fotos-produtos').getPublicUrl(path).data.publicUrl;
            }

            const payload = {
                nome,
                preco: parseFloat(document.getElementById('preco').value) || 0,
                preco_entrada: parseFloat(document.getElementById('preco_entrada').value) || 0,
                estoque: parseInt(document.getElementById('estoque').value) || 0,
                validade: document.getElementById('validade').value || null,
                imagem: urlFinal.includes('blob:') ? '' : urlFinal
            };

            const res = await fetch(id ? `${API}/${id}` : API, {
                method: id ? 'PUT' : 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(payload)
            });

            if(res.ok) { limparForm(); carregarDados(); }
            btn.disabled = false; btn.innerText = id ? "ATUALIZAR PRODUTO" : "ADICIONAR PRODUTO";
        };

        function prepararEdicao(p) {
            document.getElementById('edit-id').value = p.id;
            document.getElementById('nome').value = p.nome;
            document.getElementById('preco').value = p.preco;
            document.getElementById('preco_entrada').value = p.preco_entrada;
            document.getElementById('estoque').value = p.estoque;
            document.getElementById('validade').value = p.validade || "";
            
            const preview = document.getElementById('preview-foto-form');
            if(p.imagem) {
                preview.src = p.imagem;
                preview.style.display = 'block';
                document.getElementById('label-foto').style.display = 'none';
            }
            document.getElementById('btnSalvar').innerText = "ATUALIZAR PRODUTO";
            window.scrollTo({top: 0, behavior: 'smooth'});
        }

        function limparForm() {
            document.getElementById('edit-id').value = "";
            document.getElementById('nome').value = "";
            document.getElementById('preco').value = 0;
            document.getElementById('preco_entrada').value = 0;
            document.getElementById('estoque').value = 0;
            document.getElementById('validade').value = "";
            document.getElementById('preview-foto-form').style.display = 'none';
            document.getElementById('label-foto').style.display = 'block';
            document.getElementById('btnSalvar').innerText = "ADICIONAR PRODUTO";
        }

        async function deletar(id) { if(confirm("Apagar produto permanentemente?")) { await fetch(API + '/' + id, { method: 'DELETE' }); carregarDados(); } }

        function exportarCSV() {
            let csv = "Nome;Custo;Venda;Stock;Valor Total\n";
            produtosGlobais.forEach(p => csv += `${p.nome};${p.preco_entrada};${p.preco};${p.estoque};${(p.preco*p.estoque).toFixed(2)}\n`);
            const blob = new Blob(["\ufeff" + csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = `Inventario_Beleza_Cia.csv`;
            link.click();
        }

        window.onload = carregarDados;
    </script>
</body>
</html>
